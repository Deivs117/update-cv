# local | hosted (issue #13). "hosted" todavía no tiene adaptador
# implementado (SupabaseStorageAdapter, issue #14) -- déjalo en "local" o sin
# configurar mientras tanto.
STORAGE_MODE=local

# Espejo de STORAGE_MODE para el bundle del cliente (issue #16) -- STORAGE_MODE
# es server-side y no llega al navegador, pero la UI (/nueva-aplicacion,
# /perfil) necesita saber si la instancia es hosteada para ocultar el
# selector de modo Agente (que ahí nunca está disponible, ver get-connector.ts
# resolveClaudeMode). Debe quedar siempre en el mismo valor que STORAGE_MODE.
NEXT_PUBLIC_STORAGE_MODE=local

# Requerido solo si CLAUDE_MODE incluye "api"
ANTHROPIC_API_KEY=

# api | agent | both -- ignorado si STORAGE_MODE=hosted (el modo Agente es
# exclusivo de instalaciones locales, ver README.md)
CLAUDE_MODE=both

# Modelo a usar en modo API
CLAUDE_MODEL=claude-sonnet-5

# Proveedor de modelo en modo API: anthropic | google | nvidia
# "google" es el recomendado para instalaciones nuevas si no tienes créditos de
# Anthropic -- Gemini (AI Studio) tiene free tier real, sin tarjeta de crédito
# ni expiración, y ya cubre extractProfile (necesita visión) con el mismo
# proveedor que el resto de tareas.
MODEL_PROVIDER=google

# Requerida solo si MODEL_PROVIDER=google. Gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Requerida solo si MODEL_PROVIDER=nvidia. Gratis en https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Modelo de texto (default: meta/llama-3.2-11b-vision-instruct si se deja
# vacío -- verificado con una cuenta nueva sin pasos extra; muchos modelos
# "grandes" del catálogo devuelven 404 hasta que se solicita acceso aparte
# en el dashboard de NVIDIA)
NVIDIA_NIM_MODEL=
# Modelo con capacidad de visión, obligatorio solo para extractProfile con
# este proveedor -- NVIDIA NIM no soporta PDF nativo, solo imágenes (ver
# nvidia-nim-connector.ts). meta/llama-3.2-11b-vision-instruct (el mismo de
# arriba) ya cubre esto, verificado con una llamada real.
NVIDIA_NIM_VISION_MODEL=

# es | en
DEFAULT_LANGUAGE=es

# Umbral de años de experiencia para forzar 1 página
JUNIOR_EXPERIENCE_YEARS_THRESHOLD=3

# Máximo de páginas si se supera el umbral anterior
MAX_PAGES_SENIOR=2

# Reintentos del bucle de ajuste de página
MAX_LATEX_FIT_RETRIES=3

# Binario de compilación LaTeX: tectonic | pdflatex
LATEX_ENGINE=tectonic

# Modo Agente (sección 7.3): cada cuánto revisa la web app si Claude Code ya
# procesó la tarea, y cuánto tiempo máximo espera antes de avisar timeout.
AGENT_POLL_INTERVAL_MS=3000
AGENT_TASK_TIMEOUT_MS=900000

# Watcher del modo Agente (`npm run agent:watch`): cada cuánto revisa
# .claude-tasks/pending/, timeout por tarea antes de reintentar, y binario
# del CLI de Claude Code a invocar en modo headless (claude -p).
AGENT_WATCH_POLL_INTERVAL_MS=3000
AGENT_WATCH_TASK_TIMEOUT_MS=600000
AGENT_WATCH_CLAUDE_BIN=claude

# Modo hosteado (issue #7/#8/#9): cadena de conexión Postgres del proyecto
# Supabase (dev/preview o producción, nunca ambas en el mismo .env).
#
# IMPORTANTE (confirmado en la práctica): la conexión DIRECTA de Supabase
# (db.<ref>.supabase.co) resuelve SOLO a IPv6 -- si tu red/entorno no tiene
# salida IPv6 (común en muchos entornos de desarrollo/CI), la conexión
# simplemente cuelga sin error claro. Usa el connection pooler (Supavisor,
# sí soporta IPv4) en su lugar -- host y usuario son distintos:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (puerto 5432 = modo sesión, recomendado para migraciones; 6543 = modo
# transacción, el que usa la app en runtime vía lib/db/client.ts).
# El host/usuario exactos del pooler de tu proyecto están en Settings →
# Database del dashboard, o vía `GET /v1/projects/{ref}/config/database/pooler`
# de la Management API.
DATABASE_URL=

# URL y API key del mismo proyecto Supabase (Settings → API del dashboard, o
# `supabase projects api-keys --project-ref <ref>`). SUPABASE_SECRET_KEY (o su
# equivalente legacy "service_role") es la única con permiso para
# leer/escribir el bucket privado de Storage (#10) -- del lado del servidor
# únicamente, nunca expuesta al cliente.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Mismo proyecto, pero la URL y la publishable key (equivalente a la "anon
# key" del esquema anterior) -- estas SÍ son seguras para exponerse al
# navegador (issue #11, login con Google). NEXT_PUBLIC_SUPABASE_URL es el
# mismo valor que SUPABASE_URL de arriba, solo con el prefijo que Next.js
# exige para inyectarlo también en el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cuota diaria de generaciones por cuenta en modo hosteado (issue #18) --
# la key del proveedor de modelo la paga el dueño del servicio, no cada
# usuario, así que hace falta un tope. Default: 20 si se deja vacío.
HOSTED_DAILY_GENERATION_LIMIT=20

# Cola de jobs en modo hosteado (issue #15) -- reemplaza la cola en memoria
# de web/lib/jobs.ts, que no sobrevive entre invocaciones de una función
# serverless. Cuenta/proyecto QStash (Upstash), pendiente de provisionar
# (issue #22): free tier en https://console.upstash.com/qstash.
QSTASH_TOKEN=
# Firma de los mensajes que QStash entrega a los endpoints internos
# (app/api/internal/jobs/*) -- verificación OBLIGATORIA ahí, sin esto
# cualquiera podría invocarlos directo y disparar generación a tu costo.
# Ambas vienen del mismo dashboard de QStash (rotan juntas).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL pública de este despliegue (sin barra final), para que QStash sepa
# adónde entregar el mensaje -- ej. https://update-cv.vercel.app en
# producción, la URL de preview de Vercel en cada PR (issue #20).
APP_BASE_URL=

# Cola de jobs vía QStash (issue #15/#22). Solo modo hosteado; vienen de
# Vercel (Preview/Development -> instancia eu-central-1, Production -> otra
# instancia, para no compartir credenciales entre entornos).
# QSTASH_URL solo hace falta si la instancia no es la región por defecto.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL pública a la que QStash entrega los jobs. Si se deja vacía, en Vercel se
# usa la URL del propio deployment (VERCEL_URL). Con Deployment Protection
# activa, Vercel inyecta VERCEL_AUTOMATION_BYPASS_SECRET solo y se reenvía
# como header para que QStash pueda llegar a /api/internal/jobs/*.
APP_BASE_URL=
