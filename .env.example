# Requerido solo si CLAUDE_MODE incluye "api"
ANTHROPIC_API_KEY=

# api | agent | both
CLAUDE_MODE=both

# Modelo a usar en modo API
CLAUDE_MODEL=claude-sonnet-5

# Proveedor de modelo en modo API: anthropic | google | nvidia
# "google" es el recomendado para instalaciones nuevas si no tienes créditos de
# Anthropic -- Gemini (AI Studio) tiene free tier real, sin tarjeta de crédito
# ni expiración, y ya cubre extractProfile (necesita visión) con el mismo
# proveedor que el resto de tareas.
MODEL_PROVIDER=google

# Requerida solo si MODEL_PROVIDER=google. Gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Requerida solo si MODEL_PROVIDER=nvidia. Gratis en https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# Modelo de texto (default: meta/llama-3.2-11b-vision-instruct si se deja
# vacío -- verificado con una cuenta nueva sin pasos extra; muchos modelos
# "grandes" del catálogo devuelven 404 hasta que se solicita acceso aparte
# en el dashboard de NVIDIA)
NVIDIA_NIM_MODEL=
# Modelo con capacidad de visión, obligatorio solo para extractProfile con
# este proveedor -- NVIDIA NIM no soporta PDF nativo, solo imágenes (ver
# nvidia-nim-connector.ts). meta/llama-3.2-11b-vision-instruct (el mismo de
# arriba) ya cubre esto, verificado con una llamada real.
NVIDIA_NIM_VISION_MODEL=

# es | en
DEFAULT_LANGUAGE=es

# Umbral de años de experiencia para forzar 1 página
JUNIOR_EXPERIENCE_YEARS_THRESHOLD=3

# Máximo de páginas si se supera el umbral anterior
MAX_PAGES_SENIOR=2

# Reintentos del bucle de ajuste de página
MAX_LATEX_FIT_RETRIES=3

# Binario de compilación LaTeX: tectonic | pdflatex
LATEX_ENGINE=tectonic

# Modo Agente (sección 7.3): cada cuánto revisa la web app si Claude Code ya
# procesó la tarea, y cuánto tiempo máximo espera antes de avisar timeout.
AGENT_POLL_INTERVAL_MS=3000
AGENT_TASK_TIMEOUT_MS=900000

# Watcher del modo Agente (`npm run agent:watch`): cada cuánto revisa
# .claude-tasks/pending/, timeout por tarea antes de reintentar, y binario
# del CLI de Claude Code a invocar en modo headless (claude -p).
AGENT_WATCH_POLL_INTERVAL_MS=3000
AGENT_WATCH_TASK_TIMEOUT_MS=600000
AGENT_WATCH_CLAUDE_BIN=claude

# Modo hosteado (issue #8/#9, en construcción -- ver STORAGE_MODE en #13):
# cadena de conexión Postgres del proyecto Supabase (dev/preview o
# producción, nunca ambas en el mismo .env). Se obtiene autenticando la CLI
# de Supabase, nunca copiada a mano del dashboard (ver "Gestión de secretos"
# en CLAUDE.md). Formato: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=
