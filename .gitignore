# Secretos y configuración local
.env
.env.local

# Buzón de tareas del modo Agente (efímero, no se versiona)
.claude-tasks/pending/*
.claude-tasks/done/*
!.claude-tasks/pending/.gitkeep
!.claude-tasks/done/.gitkeep

# Aplicaciones generadas: pueden contener datos sensibles de vacantes específicas
apps/*
!apps/.gitkeep

# Node / Next.js (web/)
web/node_modules/
web/.next/
web/out/
web/build/
web/*.tsbuildinfo
web/next-env.d.ts
web/.vercel

# OS / editores
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
