# Secretos y configuración local
.env
.env.local
# Respaldo local de tokens de control de cuenta (Supabase, etc.) mientras no
# exista el manejo de secretos de Vercel -- ver CLAUDE.md "Gestión de secretos".
.secrets.local.md

# Skills de Claude Code: locales por defecto (herramientas de quien desarrolla, no
# documentación del proyecto) — excepto modo-agente/, que sí es funcionalidad del
# producto y tiene que viajar con el repo (ver CLAUDE.md).
.claude/skills/*
!.claude/skills/modo-agente/
!.claude/skills/modo-agente/**

# Buzón de tareas del modo Agente (efímero, no se versiona)
.claude-tasks/pending/*
.claude-tasks/done/*
!.claude-tasks/pending/.gitkeep
!.claude-tasks/done/.gitkeep

# Aplicaciones generadas: pueden contener datos sensibles de vacantes específicas
apps/*
!apps/.gitkeep

# Salida de prueba del pipeline LaTeX (Fase 3), no es una aplicación real
.fase3-test-output/

# Node / Next.js (web/)
web/node_modules/
web/.next/
web/out/
web/build/
web/*.tsbuildinfo
web/next-env.d.ts
web/.vercel

# OS / editores
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
